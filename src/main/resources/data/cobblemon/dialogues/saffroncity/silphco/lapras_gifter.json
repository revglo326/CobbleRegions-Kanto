{
  "initializationAction": [
    "c.npc.set_chatting();",
    "v.questID = 'gift_pokemon_lapras';",
    "v.trainerQuestID = 'defeat_boss_giovanni_2';",
    "v.hasDefeatedTrainer = c.player.has_advancement('rctmod:trainers/' + v.trainerQuestID);",
    "v.hasGiftedPlayer = c.player.has_advancement('cobbleregionskanto:progression/' + v.questID);",
    "v.landing_page = v.hasGiftedPlayer ? 'alreadyGifted' : (!v.hasDefeatedTrainer ? 'chatting' : 'defeatedTeamRocket');",
    "q.dialogue.set_page(v.landing_page);"
  ],
  "pages": [
    {
      "id": "alreadyGifted",
      "input": "q.dialogue.close();",
      "lines": [
        "TEAM ROCKET's BOSS went to the boardroom! Is our PRESIDENT OK?"
      ],
      "speaker": "npc"
    },
    {
      "id": "chatting",
      "lines": [
        "Oh! Hi! You're not a ROCKET!"
      ],
      "speaker": "npc"
    },
    {
      "id": "chatting1",
      "lines": [
        "You came to save us? Why, thank you!"
      ],
      "speaker": "npc"
    },
    {
      "id": "chatting1",
      "input": [
        "v.callback_dialogue = 'lapras_obtained';",
        "c.npc.run_action_effect('npc_complete_quest');",
        "q.dialogue.close();"
      ],
      "lines": [
        "I want you to have this POKEMON for saving us."
      ],
      "speaker": "npc"
    }
  ],
  "speakers": {
    "npc": {
      "face": "q.npc.face();",
      "gibber": {},
      "name": {
        "expression": "q.npc.name",
        "type": "expression"
      }
    },
    "player": {
      "face": "q.player.face();",
      "name": {
        "expression": "q.player.username",
        "type": "expression"
      }
    }
  }
}