{
  "initializationAction": [
    "c.npc.set_chatting();",
    "v.questID = 'receive_good_rod';",
    "v.hasGiftedPlayer = c.player.has_advancement('cobbleregionskanto:progression/receive_good_rod');",
    "v.landing_page = (v.hasGiftedPlayer != 1) ? 'chatting1' : 'already_has_rod';",
    "q.dialogue.set_page(v.landing_page);"
  ],
  "pages": [
    {
      "id": "already_has_rod",
      "input": "q.dialogue.close();",
      "lines": [
        "How's the fishing going, friend?"
      ],
      "speaker": "npc"
    },
    {
      "id": "chatting1",
      "lines": [
        "I'm the FISHING GURU's older brother."
      ],
      "speaker": "npc"
    },
    {
      "id": "chatting2",
      "lines": [
        "I simply looove fishing!",
        "I can't bear to go without."
      ],
      "speaker": "npc"
    },
    {
      "id": "chatting3",
      "input": {
        "options": [
          {
            "action": "q.dialogue.set_page('yes');",
            "text": "Yes",
            "value": "yes"
          },
          {
            "action": "q.dialogue.set_page('no');",
            "text": "No",
            "value": "no"
          }
        ],
        "type": "option",
        "vertical": false
      },
      "lines": [
        "Tell me, do you like to fish?"
      ],
      "speaker": "npc"
    },
    {
      "id": "yes",
      "lines": [
        "Grand! I like your style.",
        "I think we can be friends."
      ],
      "speaker": "npc"
    },
    {
      "id": "yes2",
      "input": [
        "v.callback_dialogue = 'good_rod_accept';",
        "c.npc.run_action_effect('npc_complete_quest');",
        "q.dialogue.close();"
      ],
      "lines": [
        "Take this and fish, young friend!"
      ],
      "speaker": "npc"
    },
    {
      "id": "no",
      "input": "q.dialogue.close();",
      "lines": [
        "Oh...",
        "That's so disappointing..."
      ],
      "speaker": "npc"
    }
  ],
  "speakers": {
    "npc": {
      "face": "q.npc.face();",
      "gibber": {},
      "name": {
        "expression": "q.npc.name",
        "type": "expression"
      }
    },
    "player": {
      "face": "q.player.face();",
      "name": {
        "expression": "q.player.username",
        "type": "expression"
      }
    }
  }
}