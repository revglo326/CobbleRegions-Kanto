{
  "initializationAction": "(q.npc.is_in_battle_with(q.player) || !q.npc.is_doing_activity('minecraft:idle', 'cobblemon:battling')) ? q.dialogue.close()",
  "pages": [
    {
      "id": "player-chat",
      "input": "q.dialogue.set_page(q.npc.was_hurt_by(q.player) ? 'hurt-1' : 'npc-chat');",
      "lines": [
        {
          "expression": "'Hello, I\\'m ' + q.player.username + '!'",
          "type": "expression"
        }
      ],
      "speaker": "player"
    },
    {
      "id": "hurt-1",
      "input": "q.dialogue.close();",
      "lines": [
        "Do you think I'd talk to you after you attacked me!? Get out of here!"
      ],
      "speaker": "npc"
    },
    {
      "id": "npc-chat",
      "input":
      {
        "options": [
          {
            "action": [
              "q.dialogue.close();",
              "q.npc.start_battle(q.player, 'double');"
            ],
            "isSelectable": "c.npc.can_battle;",
            "text": "Battle",
            "value": "battle"
          },
          {
            "action": [],
            "isSelectable": "false",
            "text": "Trade",
            "value": "trade"
          },
          {
            "action": [
              "q.dialogue.close()"
            ],
            "text": "Cancel",
            "value": "cancel"
          }
        ],
        "type": "option",
        "vertical": false
      },
      "lines": [
        {
          "expression": "'Hello, ' + q.player.username + '! I\\'m ' + q.npc.name + '!'",
          "type": "expression"
        }
      ],
      "speaker": "npc"
    }
  ],
  "speakers": {
    "npc": {
      "face": "q.npc.face(false);",
      "name": {
        "expression": "q.npc.name",
        "type": "expression"
      }
    },
    "player": {
      "face": "q.player.face();",
      "name": {
        "expression": "q.player.username",
        "type": "expression"
      }
    }
  }
}