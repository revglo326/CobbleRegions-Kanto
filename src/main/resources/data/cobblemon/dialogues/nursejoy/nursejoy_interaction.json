{
    "initializationAction": [
        "c.npc.set_chatting();",
        "v.healer = c.npc.find_nearby_block('cobblemon:healing_machine');",
        "v.has_healer = v.healer != 0;",
        "v.full_health = c.player.is_party_at_full_health();",
        "v.has_charge = v.has_healer == true && v.full_health == false && q.player.can_heal_at_healer(v.healer) == true;",
        "v.landing_page = !v.has_healer ? 'no_healer' : (v.full_health ? 'full_health' : (v.has_charge ? 'has_charge' : 'no_charge'));"
    ],
    "pages": [
        {
            "clientActions": [
                "q.face.play_animation('win');"
            ],
            "id": "greeting",
            "input": "q.dialogue.set_page(v.landing_page);",
            "lines": [
                "Welcome to our Pokémon Center!"
            ],
            "speaker": "npc"
        },
        {
            "id": "no_healer",
            "input": "q.dialogue.close();",
            "lines": [
                "I would offer to heal your Pokémon, but I can't seem to find my healing machine...",
                "I'm sorry about that!"
            ],"speaker": "npc"
        },
        {
            "id": "full_health",
            "input": "q.dialogue.close();",
            "lines": [
                "Your Pokémon are completely healthy!"
            ],
            "speaker": "npc"
        },
        {
            "id": "no_charge",
            "input": "q.dialogue.close();",
            "lines": [
                "I'd like to heal your Pokémon but my machine is busy! Please come back later!"
            ],
            "speaker": "npc"
        },
        {
            "id": "has_charge",
            "input": {
                "options": [
                    {
                        "action": [
                            "v.callback_dialogue = 'sacchi_healed';",
                            "c.npc.run_action_effect('npc_heal_player_pokemon');",
                            "q.dialogue.close();"
                        ],
                        "text": "Yes",
                        "value": "yes"
                    },
                    {
                        "action": "q.dialogue.set_page('okbye');",
                        "text": "No",
                        "value": "no"
                    }
                ],
                "type": "option",
                "vertical": false
            },
            "lines": [
                "Would you like me to heal your Pokémon?"
            ],
            "speaker": "npc"
        },
        {
            "id": "okbye",
            "input": "q.dialogue.close();",
            "lines": [
                "Alright, see you later!"
            ],
            "speaker": "npc"
        }
    ],
    "speakers": {
        "npc": {
            "face": "q.npc.face();",
            "gibber": {},
            "name": {
                "expression": "q.npc.name",
                "type": "expression"
            }
        },
        "player": {
            "face": "q.player.face();",
            "name": {
                "expression": "q.player.username",
                "type": "expression"
            }
        }
    }
}